# FRED API Configuration
FRED_API_KEY=your_fred_api_key_here

# Storage Configuration
STORAGE_MODE=local  # "local" or "s3"
S3_BUCKET=fixedsense-data
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Data Ingestion
USE_SAMPLE_DATA=true  # true to use sample_data/ CSVs, false to fetch from FRED

# Portfolio
PORTFOLIO_CONFIG_PATH=config/portfolio.yaml
SCENARIOS_CONFIG_PATH=config/scenarios.yaml

# Risk Computation
MONTE_CARLO_PATHS=10000
MONTE_CARLO_HORIZON_DAYS=1
VAR_CONFIDENCE=0.95
ES_CONFIDENCE=0.975
PCA_LOOKBACK_DAYS=504  # ~2 years

# Kafka (optional for v1)
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_RISK=fixedsense.risk.events
KAFKA_TOPIC_ALERTS=fixedsense.alerts

# Alerts
ALERT_VAR_THRESHOLD_PCT=0.80
ALERT_CONCENTRATION_THRESHOLD_PCT=0.60
ALERT_SPREAD_WIDENING_BPS=20

# Logging
LOG_LEVEL=INFO
